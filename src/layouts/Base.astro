---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
import { organizacionLd } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  /** Ruta de la página sin barra final (ej. "/servicios"). Por defecto, la URL actual. */
  path?: string;
  ogImage?: string;
  noindex?: boolean;
  /** Datos estructurados adicionales de la página (se suman a los de la empresa). */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  path = Astro.url.pathname,
  ogImage = site.ogImage,
  noindex = false,
  jsonLd = [],
} = Astro.props;

const origen = Astro.site!;
const canonical = new URL(path, origen).href;
const imagen = new URL(ogImage, origen).href;
const datos = JSON.stringify([organizacionLd(origen), ...jsonLd]).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1c1a4e" />
    {noindex && <meta name="robots" content="noindex" />}
    {site.googleSiteVerification && (
      <meta name="google-site-verification" content={site.googleSiteVerification} />
    )}
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tensor TI: soporte TI en terreno, redes y auditoría" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={datos} />
  </head>
  <body>
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
