---
// Sección de servicios del inicio: los principales numerados y el resto como etiquetas.
import ListaServicios from "./ListaServicios.astro";
import { servicios, otrosServicios, rutaServicio } from "../data/servicios";

const principales = servicios.filter((s) => s.principal);
const tambien = servicios.filter((s) => !s.principal);
---
<section id="servicios">
  <div class="wrap">
    <p class="etiqueta">Servicios</p>
    <h2>Lo que hacemos</h2>

    <ListaServicios items={principales} tituloHome />

    <p class="etiqueta tambien-t">También</p>
    <ul class="tambien">
      {tambien.map((s) => (
        <li><a href={rutaServicio(s.slug)}>{s.nombre}</a></li>
      ))}
      {otrosServicios.map((t) => <li>{t}</li>)}
    </ul>

    <p class="todos"><a class="enlace" href="/servicios">Ver todos los servicios →</a></p>
  </div>
</section>

<style>
  .tambien-t { margin-top: 2.5rem; }
  .tambien { display: flex; flex-wrap: wrap; gap: 0.6rem; list-style: none; padding: 0; margin: 0.8rem 0 0; }
  .tambien li {
    border: 1px solid var(--linea);
    padding: 0.5rem 0.9rem;
    border-radius: 2rem;
    font-size: 0.95rem;
    color: var(--gris);
  }
  .tambien a { color: var(--tinta); text-decoration: none; }
  .tambien li:has(a):hover { border-color: var(--terracota); }
  .tambien a:hover { text-decoration: underline; text-underline-offset: 0.2em; }
  .todos { margin: 2rem 0 0; }
</style>
