---
// Llamada a la acción reutilizable para el final de cada página.
import { contactoUrl, whatsappUrl } from "../lib/contacto";

interface Props {
  titulo?: string;
  texto?: string;
  /** Slug del servicio para llegar al formulario con el servicio ya elegido. */
  servicio?: string;
  /** Texto del mensaje de WhatsApp. */
  mensaje?: string;
}
const {
  titulo = "¿Necesitas una cotización?",
  texto = "Cuéntanos qué necesitas y te respondemos con una propuesta y los plazos.",
  servicio,
  mensaje,
} = Astro.props;
const wa = whatsappUrl(mensaje);
---
<section class="cta">
  <div class="wrap">
    <div class="tarjeta oscuro">
      <div class="texto">
        <h2>{titulo}</h2>
        <p>{texto}</p>
      </div>
      <div class="acciones">
        <a class="btn btn-primario" href={contactoUrl({ servicio })}>Solicitar cotización</a>
        {wa && <a class="btn btn-borde" href={wa}>Escribir por WhatsApp</a>}
      </div>
    </div>
  </div>
</section>

<style>
  /* Sin fondo propio: deja ver el fondo claro de la página para separarse del footer. */
  .cta { background: transparent; padding: 3rem 0; }

  .tarjeta {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.4rem 2rem;
    padding: 2rem 2.2rem;
    border-radius: 1rem;
    color: #fff;
    background: linear-gradient(135deg, var(--azul-osc) 0%, #1d1a4d 100%);
    border-top: 4px solid var(--terracota-claro);
    box-shadow: 0 10px 30px rgba(18, 16, 58, 0.18);
    overflow: hidden;
  }

  .texto { flex: 1 1 22rem; }
  h2 { margin: 0 0 0.5rem; font-size: clamp(1.4rem, 3vw, 1.9rem); color: #fff; }
  p { margin: 0; color: rgba(255, 255, 255, 0.82); max-width: 38rem; }

  .acciones { display: flex; flex-wrap: wrap; gap: 0.8rem; }

  @media (max-width: 700px) {
    .cta { padding: 2rem 0; }
    .tarjeta { padding: 1.6rem 1.3rem; }
  }
</style>