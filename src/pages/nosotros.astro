---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import QuienesSomos from "../components/QuienesSomos.astro";
import ProveedorEstado from "../components/ProveedorEstado.astro";
import Proyectos from "../components/Proyectos.astro";
import Metodo from "../components/Metodo.astro";
import CtaBanda from "../components/CtaBanda.astro";
import { breadcrumbLd } from "../lib/seo";

const migas = [{ nombre: "Inicio", href: "/" }, { nombre: "Nosotros" }];
---
<Base
  title="Quiénes somos | Tensor TI, empresa TI de Pozo Almonte"
  description="Tensor TI SpA (RUT 78.533.738-7), de Pozo Almonte: soporte TI en terreno en Iquique y Tarapacá, y desarrollo de software. Proveedor en Mercado Público."
  path="/nosotros"
  jsonLd={[
    breadcrumbLd(
      [
        { nombre: "Inicio", ruta: "/" },
        { nombre: "Nosotros", ruta: "/nosotros" },
      ],
      Astro.site!,
    ),
  ]}
>
  <PageHero
    etiqueta="Nosotros"
    titulo="Soporte en terreno y desarrollo de software, desde Tarapacá"
    lead="Quiénes somos, cómo trabajamos y los datos que necesitas para contratarnos, también a través de Mercado Público."
    migas={migas}
  />

  <QuienesSomos completo />
  <Proyectos />
  <ProveedorEstado />
  <Metodo />
  <CtaBanda />
</Base>
