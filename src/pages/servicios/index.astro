---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import ListaServicios from "../../components/ListaServicios.astro";
import BandaSoporteMensual from "../../components/BandaSoporteMensual.astro";
import Metodo from "../../components/Metodo.astro";
import CtaBanda from "../../components/CtaBanda.astro";
import { servicios } from "../../data/servicios";
import { breadcrumbLd } from "../../lib/seo";

const origen = Astro.site!;
const migas = [{ nombre: "Inicio", href: "/" }, { nombre: "Servicios" }];
---
<Base
  title="Servicios informáticos en Iquique y Tarapacá | Tensor TI"
  description="Soporte TI, redes, mantención de equipos, CCTV, desarrollo web y apps, hosting y técnicos para faenas en Iquique, Alto Hospicio, Pozo Almonte y Tarapacá."
  path="/servicios"
  jsonLd={[
    breadcrumbLd(
      [
        { nombre: "Inicio", ruta: "/" },
        { nombre: "Servicios", ruta: "/servicios" },
      ],
      origen,
    ),
  ]}
>
  <PageHero
    etiqueta="Servicios"
    titulo="Servicios informáticos para empresas e instituciones"
    lead="Trabajamos desde Pozo Almonte: en terreno en la Región de Tarapacá y a distancia en todo Chile para desarrollo y hosting. Cada servicio se cotiza según tu caso, sin paquetes genéricos."
    migas={migas}
  />

  <section>
    <div class="wrap">
      <h2>Qué podemos hacer por ti</h2>
      <ListaServicios items={servicios} />
    </div>
  </section>

  <BandaSoporteMensual />
  <Metodo />
  <CtaBanda />
</Base>
